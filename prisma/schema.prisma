// prisma/schema.prisma
//
// CHANGELOG (Offer System Fixes — 2026-02-06):
// [Issue #4]  Changed offers.status from VarChar(20) to VarChar(30) — prevents overflow for future statuses
// [Issue #36] Added composite indexes: (status, expires_at), (status, acceptance_expires_at), (listing_id, buyer_id)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model conversations {
  id                                   String     @id
  listing_id                           String
  buyer_id                             String
  seller_id                            String
  last_message_at                      DateTime   @default(now())
  is_archived                          Boolean    @default(false)
  created_at                           DateTime   @default(now())
  users_conversations_buyer_idTousers  users      @relation("conversations_buyer_idTousers", fields: [buyer_id], references: [id], onDelete: Cascade)
  listings                             listings   @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  users_conversations_seller_idTousers users      @relation("conversations_seller_idTousers", fields: [seller_id], references: [id], onDelete: Cascade)
  messages                             messages[]

  @@unique([listing_id, buyer_id])
  @@index([buyer_id])
  @@index([listing_id])
  @@index([seller_id])
}

model favorites {
  id         String   @id
  user_id    String
  listing_id String
  created_at DateTime @default(now())
  listings   listings @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, listing_id])
  @@index([listing_id])
  @@index([user_id])
}

model images {
  id            String   @id
  listing_id    String
  image_url     String
  s3_key        String
  is_primary    Boolean  @default(false)
  display_order Int      @default(0)
  alt_text      String?
  created_at    DateTime @default(now())
  listings      listings @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@index([listing_id])
  @@index([listing_id, is_primary])
}

model listing_attributes {
  id         String   @id
  listing_id String
  key        String
  value      String
  created_at DateTime @default(now())
  listings   listings @relation(fields: [listing_id], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([key, value])
  @@index([listing_id])
}

model listings {
  id                  String               @id
  seller_id           String
  title               String
  description         String?
  category            String
  brand               String?
  model               String?
  price               Decimal              @db.Decimal(10, 2)
  original_price      Decimal?             @db.Decimal(10, 2)
  currency            String               @default("GBP")
  status              String               @default("active")
  location            String?
  is_featured         Boolean              @default(false)
  is_negotiable       Boolean              @default(true)
  views               Int                  @default(0)
  favorites_count     Int                  @default(0)
  created_at          DateTime             @default(now())
  updated_at          DateTime
  ball_condition_type String?
  condition_grip      Int?
  condition_head      Int?
  condition_overall   Int?
  condition_shaft     Int?
  subcategory         String?
  specifications      Json?
  parcel_size         String?
  shipping_cost       Decimal?             @db.Decimal(10, 2)
  quantity            Int                  @default(1)
  deleted_at          DateTime?
  cart_items          cart_items[]
  conversations       conversations[]
  favorites           favorites[]
  images              images[]
  listing_attributes  listing_attributes[]
  users               users                @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  offers              offers[]
  orders              orders[]
  // Chip AI Caddy relations
  chip_conversations  chip_conversations[]

  @@index([brand])
  @@index([category])
  @@index([subcategory])
  @@index([condition_overall])
  @@index([created_at])
  @@index([location])
  @@index([price])
  @@index([seller_id])
  @@index([status])
}

model messages {
  id                                String        @id
  conversation_id                   String
  sender_id                         String
  receiver_id                       String
  content                           String
  message_type                      String        @default("text")
  offer_amount                      Decimal?      @db.Decimal(10, 2)
  is_read                           Boolean       @default(false)
  created_at                        DateTime      @default(now())
  conversations                     conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  users_messages_receiver_idTousers users         @relation("messages_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: Cascade)
  users_messages_sender_idTousers   users         @relation("messages_sender_idTousers", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([created_at])
  @@index([receiver_id])
  @@index([sender_id])
}

model orders {
  id                            String            @id
  listing_id                    String?
  buyer_id                      String
  seller_id                     String
  amount                        Decimal           @db.Decimal(10, 2)
  currency                      String            @default("GBP")
  stripe_payment_intent_id      String?
  stripe_payment_method_id      String?
  status                        String            @default("pending")
  shipping_address              Json?
  tracking_number               String?
  source              String?              @db.VarChar(30)
  created_at                    DateTime          @default(now())
  paid_at                       DateTime?
  shipped_at                    DateTime?
  delivered_at                  DateTime?
  reminder_sent_at              DateTime?
  completed_at                  DateTime?
  updated_at                    DateTime
  auto_cancel_at                DateTime?
  cancel_reason                 String?
  cancelled_at                  DateTime?
  carrier                       String?
  dispute_reason                String?
  disputed_at                   DateTime?
  seller_payout                 Decimal?          @db.Decimal(10, 2)
  buyer_total                   Decimal?          @db.Decimal(10, 2)
  label_url                     String?
  shipping_cost                 Decimal?          @db.Decimal(10, 2)
  shippo_shipment_id            String?
  shippo_transaction_id         String?
  buyer_viewed_at               DateTime?
  escrow_release_at             DateTime?
  reported_lost_at              DateTime?
  quantity                      Int               @default(1)
  listing_image                 String?
  listing_price                 Decimal?          @db.Decimal(10, 2)
  listing_title                 String?
  selected_size                 String?
  label_cost                    Decimal?          @db.Decimal(10, 2)
  lost_notification_sent_at     DateTime?
  refund_amount                 Decimal?          @db.Decimal(10, 2)
  refunded_at                   DateTime?
  stripe_refund_id              String?
  stripe_transfer_id            String?
  payout_blocked_at             DateTime?
  buyer_confirmed_at            DateTime?
  payout_reminder_sent_at       DateTime?
  insurance_claim_id            String?
  insurance_claim_status        String?
  insurance_premium             Decimal?          @db.Decimal(10, 2)
  insured_value                 Decimal?          @db.Decimal(10, 2)
  label_auto_generated          Boolean?
  offer_id                      String?           @db.VarChar(255)
  original_list_price           Decimal?          @db.Decimal(10, 2)
  discount_amount               Decimal?          @default(0) @db.Decimal(10, 2)
  qr_code_url                   String?
  qr_code_expires_at            DateTime?
  disputes                      disputes?
  users_orders_buyer_idTousers  users             @relation("orders_buyer_idTousers", fields: [buyer_id], references: [id])
  listings                      listings?         @relation(fields: [listing_id], references: [id])
  offer                         offers?           @relation(fields: [offer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_orders_seller_idTousers users             @relation("orders_seller_idTousers", fields: [seller_id], references: [id])
  return_requests               return_requests[]
  reviews                       reviews[]
  support_tickets               support_tickets[]

  @@index([buyer_id])
  @@index([created_at])
  @@index([seller_id])
  @@index([status])
  @@index([auto_cancel_at])
  @@index([offer_id], map: "idx_orders_offer_id")
  @@index([payout_blocked_at])
}

model reviews {
  id                                    String   @id
  order_id                              String
  reviewer_id                           String
  reviewed_user_id                      String
  rating                                Int
  review_text                           String?
  review_type                           String
  is_public                             Boolean  @default(true)
  created_at                            DateTime @default(now())
  orders                                orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  users_reviews_reviewed_user_idTousers users    @relation("reviews_reviewed_user_idTousers", fields: [reviewed_user_id], references: [id], onDelete: Cascade)
  users_reviews_reviewer_idTousers      users    @relation("reviews_reviewer_idTousers", fields: [reviewer_id], references: [id], onDelete: Cascade)
}

model users {
  id                                           String            @id
  cognito_id                                   String            @unique
  email                                        String            @unique
  display_name                                 String?
  phone                                        String?
  location                                     String?
  bio                                          String?
  avatar_url                                   String?
  is_verified_seller                           Boolean           @default(false)
  rating                                       Decimal           @default(0.00) @db.Decimal(3, 2)
  total_sales                                  Int               @default(0)
  total_purchases                              Int               @default(0)
  created_at                                   DateTime          @default(now())
  updated_at                                   DateTime
  deletion_requested_at                        DateTime?
  deletion_scheduled_for                       DateTime?
  default_shipping_cost                        Decimal?          @db.Decimal(10, 2)
  offers_free_shipping                         Boolean           @default(false)
  postcode_area                                String?
  sending_address                              Json?
  preferred_carriers                           String?
  email_notifications                          Boolean           @default(true)
  marketing_emails                             Boolean           @default(false)
  sms_marketing_consent                        Boolean           @default(false)
  order_notifications                          Boolean           @default(true)
  handicap                                     String?
  clothing_size                                String[]
  glove_size                                   String[]
  shoe_size                                    String[]
  sizing_preference                            String?
  stripe_connect_id                            String?           @db.VarChar(255)
  stripe_connect_status                        String?           @db.VarChar(50)
  shipping_strikes                             Int               @default(0)
  buyer_cancellation_count                     Int               @default(0)
  seller_cancellation_count                    Int               @default(0)
  push_token                                   String?
  push_token_platform                          String?           @db.VarChar(10)
  is_banned                                    Boolean           @default(false)
  ban_reason                                   String?
  banned_at                                    DateTime?
  password_reset_code                          String?
  password_reset_code_expires                  DateTime?
  verification_code                            String?
  verification_code_expires                    DateTime?
  verified_seller_at                           DateTime?
  is_pro_store                                 Boolean           @default(false)
  pro_store_name                               String?           @db.VarChar(100)
  pro_store_website                            String?           @db.VarChar(255)
  pro_store_approved_at                        DateTime?
  subscription_status                          String?           @db.VarChar(30)
  subscription_started_at                      DateTime?
  signup_platform                              String?           @db.VarChar(10)
  blocked_by                                   blocked_users[]   @relation("BlockedByBlocks")
  users_blocked                                blocked_users[]   @relation("BlockerBlocks")
  cart_items                                   cart_items[]
  conversations_conversations_buyer_idTousers  conversations[]   @relation("conversations_buyer_idTousers")
  conversations_conversations_seller_idTousers conversations[]   @relation("conversations_seller_idTousers")
  disputes_as_buyer                            disputes[]        @relation("disputes_buyer_idTousers")
  disputes_as_seller                           disputes[]        @relation("disputes_seller_idTousers")
  favorites                                    favorites[]
  feedback                                     Feedback[]
  listings                                     listings[]
  messages_messages_receiver_idTousers         messages[]        @relation("messages_receiver_idTousers")
  messages_messages_sender_idTousers           messages[]        @relation("messages_sender_idTousers")
  notifications_triggered                      notifications[]   @relation("notifications_related_user_idTousers")
  notifications_received                       notifications[]   @relation("notifications_user_idTousers")
  offers_as_buyer                              offers[]          @relation("offers_buyer_idTousers")
  offers_as_seller                             offers[]          @relation("offers_seller_idTousers")
  orders_orders_buyer_idTousers                orders[]          @relation("orders_buyer_idTousers")
  orders_orders_seller_idTousers               orders[]          @relation("orders_seller_idTousers")
  return_labels_paid                           return_requests[] @relation("return_payer")
  return_requests_made                         return_requests[] @relation("return_requester")
  reviews_reviews_reviewed_user_idTousers      reviews[]         @relation("reviews_reviewed_user_idTousers")
  reviews_reviews_reviewer_idTousers           reviews[]         @relation("reviews_reviewer_idTousers")
  support_tickets                              support_tickets[]
  reports_received                             user_reports[]    @relation("ReportedUserReports")
  reports_made                                 user_reports[]    @relation("ReporterReports")
  // Chip AI Caddy relations
  fitting_profile                          fitting_profiles?
  chip_conversations                       chip_conversations[]
  pro_store_applications                   pro_store_applications[]
  refresh_tokens                           refresh_tokens[]
}

model notifications {
  id              String   @id
  user_id         String
  type            String
  title           String
  message         String
  related_id      String?
  related_user_id String?
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())
  image_url       String?
  related_user    users?   @relation("notifications_related_user_idTousers", fields: [related_user_id], references: [id])
  user            users    @relation("notifications_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@index([created_at])
  @@index([related_user_id])
}

model Feedback {
  id            Int      @id @default(autoincrement())
  userId        String?  @map("user_id")
  feedbackType  String   @map("feedback_type") @db.VarChar(50)
  screenFeature String   @map("screen_feature") @db.VarChar(100)
  description   String
  severity      String   @db.VarChar(20)
  deviceInfo    String?  @map("device_info")
  status        String   @default("new") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  user          users?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("feedback")
}

model support_tickets {
  id         String                  @id
  user_id    String
  type       String
  order_id   String?
  subject    String
  message    String
  status     String                  @default("open")
  created_at DateTime                @default(now())
  updated_at DateTime                @updatedAt
  priority   String                  @default("normal")
  images     support_ticket_images[]
  orders     orders?                 @relation(fields: [order_id], references: [id])
  users      users                   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("support_tickets")
}

model support_ticket_images {
  id              String          @id
  ticket_id       String
  image_url       String
  s3_key          String
  created_at      DateTime        @default(now())
  support_tickets support_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade)

  @@index([ticket_id])
  @@map("support_ticket_images")
}

model cart_items {
  id            String   @id
  user_id       String
  listing_id    String
  added_at      DateTime @default(now())
  expires_at    DateTime
  quantity      Int      @default(1)
  selected_size String?
  offer_id      String?  @db.VarChar(255)
  offer_price   Decimal? @db.Decimal(10, 2)
  listings      listings @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, listing_id, selected_size])
  @@index([user_id])
  @@index([listing_id])
  @@index([expires_at])
  @@index([offer_id], map: "idx_cart_items_offer_id")
  @@map("cart_items")
}

model email_suppressions {
  id             String   @id @default(uuid())
  email          String   @unique
  reason         String
  bounce_type    String?
  bounce_subtype String?
  source         String?
  created_at     DateTime @default(now())

  @@index([email])
  @@index([reason])
  @@map("email_suppressions")
}

model user_reports {
  id               String   @id @default(uuid())
  reporter_id      String
  reported_user_id String
  reason           String
  details          String?
  conversation_id  String?
  listing_id       String?
  status           String   @default("pending")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  reported_user    users    @relation("ReportedUserReports", fields: [reported_user_id], references: [id])
  reporter         users    @relation("ReporterReports", fields: [reporter_id], references: [id])

  @@index([reporter_id])
  @@index([reported_user_id])
  @@index([status])
}

model blocked_users {
  id         String   @id @default(uuid())
  blocker_id String
  blocked_id String
  created_at DateTime @default(now())
  blocked    users    @relation("BlockedByBlocks", fields: [blocked_id], references: [id])
  blocker    users    @relation("BlockerBlocks", fields: [blocker_id], references: [id])

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
  @@index([blocked_id])
}

model disputes {
  id                       String            @id @default(uuid())
  order_id                 String            @unique
  buyer_id                 String
  seller_id                String
  status                   String            @default("open")
  reason_type              String
  reason_text              String
  requested_refund_percent Int
  requested_refund_amount  Decimal           @db.Decimal(10, 2)
  seller_response_type     String?
  counter_offer_percent    Int?
  counter_offer_amount     Decimal?          @db.Decimal(10, 2)
  seller_response_text     String?
  seller_responded_at      DateTime?
  resolution_type          String?
  resolution_amount        Decimal?          @db.Decimal(10, 2)
  resolution_notes         String?
  resolved_by              String?
  resolved_at              DateTime?
  seller_deadline          DateTime
  buyer_deadline           DateTime?
  auto_escalated           Boolean           @default(false)
  created_at               DateTime          @default(now())
  updated_at               DateTime          @updatedAt
  escalated_at             DateTime?
  escalation_reason        String?
  dispute_images           dispute_images[]
  users_disputes_buyer     users             @relation("disputes_buyer_idTousers", fields: [buyer_id], references: [id], onDelete: Cascade)
  orders                   orders            @relation(fields: [order_id], references: [id], onDelete: Cascade)
  users_disputes_seller    users             @relation("disputes_seller_idTousers", fields: [seller_id], references: [id], onDelete: Cascade)
  return_requests          return_requests[]

  @@index([order_id])
  @@index([buyer_id])
  @@index([seller_id])
  @@index([status])
  @@index([seller_deadline])
  @@index([created_at])
  @@map("disputes")
}

model dispute_images {
  id          String   @id @default(uuid())
  dispute_id  String
  image_url   String
  s3_key      String
  uploaded_by String
  created_at  DateTime @default(now())
  disputes    disputes @relation(fields: [dispute_id], references: [id], onDelete: Cascade)

  @@index([dispute_id])
  @@map("dispute_images")
}

model return_requests {
  id                     String    @id @default(cuid())
  order_id               String
  dispute_id             String?
  requested_by           String
  approved_by            String?
  reason                 String
  status                 String    @default("pending")
  return_label_url       String?
  return_tracking_number String?
  return_carrier         String?
  label_cost             Decimal?  @db.Decimal(10, 2)
  paid_by                String?
  shippo_transaction_id  String?
  refund_amount          Decimal?  @db.Decimal(10, 2)
  shipping_deducted      Decimal?  @db.Decimal(10, 2)
  shipped_at             DateTime?
  delivered_at           DateTime?
  escrow_release_at      DateTime?
  completed_at           DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  return_ship_deadline   DateTime?
  reminder_sent_at       DateTime?
  stripe_refund_id       String?
  qr_code_url            String?
  qr_code_expires_at     DateTime?
  is_forced              Boolean   @default(false)
  disputes               disputes? @relation(fields: [dispute_id], references: [id])
  orders                 orders    @relation(fields: [order_id], references: [id])
  payer                  users?    @relation("return_payer", fields: [paid_by], references: [id])
  requester              users     @relation("return_requester", fields: [requested_by], references: [id])

  @@index([order_id])
  @@index([dispute_id])
  @@index([status])
}

model offers {
  id                    String    @id @default(uuid()) @db.VarChar(255)
  listing_id            String    @db.VarChar(255)
  buyer_id              String    @db.VarChar(255)
  seller_id             String    @db.VarChar(255)
  list_price            Decimal   @db.Decimal(10, 2)
  offer_amount          Decimal   @db.Decimal(10, 2)
  counter_amount        Decimal?  @db.Decimal(10, 2)
  final_amount          Decimal?  @db.Decimal(10, 2)
  status                String    @default("PENDING") @db.VarChar(30) // [Issue #4] Was VarChar(20)
  offer_number          Int
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  expires_at            DateTime  @db.Timestamp(6)
  responded_at          DateTime? @db.Timestamp(6)
  acceptance_expires_at DateTime? @db.Timestamp(6)
  purchased_at          DateTime? @db.Timestamp(6)
  warning_sent          Boolean?  @default(false)
  buyer                 users     @relation("offers_buyer_idTousers", fields: [buyer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  listings              listings  @relation(fields: [listing_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seller                users     @relation("offers_seller_idTousers", fields: [seller_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders                orders[]

  @@index([buyer_id], map: "idx_offers_buyer")
  @@index([listing_id], map: "idx_offers_listing")
  @@index([seller_id], map: "idx_offers_seller")
  @@index([status], map: "idx_offers_status")
  @@index([status, expires_at], map: "idx_offers_status_expires_at")                         // [Issue #36]
  @@index([status, acceptance_expires_at], map: "idx_offers_status_acceptance_expires")       // [Issue #36]
  @@index([listing_id, buyer_id], map: "idx_offers_listing_buyer")                           // [Issue #36]
}

// ============================================
// CHIP AI CADDY — Fitting & Chat Models
// Added: 2026-02-12
// ============================================

model fitting_profiles {
  id                String               @id @default(uuid())
  user_id           String               @unique
  handicap          String?              @db.VarChar(30)
  dexterity         String?              @db.VarChar(10)
  height_cm         Int?
  looking_for       String[]
  play_frequency    String?              @db.VarChar(30)
  goals             String[]
  budget_range      String?              @db.VarChar(30)
  condition_pref    String?              @db.VarChar(30)
  brand_preferences String[]
  glove_size        String?              @db.VarChar(10)
  created_at        DateTime             @default(now())
  updated_at        DateTime             @updatedAt

  user              users                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bag_clubs         fitting_bag_clubs[]
  swing_data        fitting_swing_data[]

  @@index([user_id])
  @@map("fitting_profiles")
}

model fitting_bag_clubs {
  id          String           @id @default(uuid())
  profile_id  String
  club_type   String           @db.VarChar(30)
  brand       String?          @db.VarChar(50)
  model       String?          @db.VarChar(100)
  shaft_flex  String?          @db.VarChar(20)
  loft        Decimal?         @db.Decimal(4, 1)
  notes       String?
  created_at  DateTime         @default(now())

  profile     fitting_profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@map("fitting_bag_clubs")
}

model fitting_swing_data {
  id               String           @id @default(uuid())
  profile_id       String
  club_type        String?          @db.VarChar(30)
  club_speed_mph   Decimal?         @db.Decimal(5, 1)
  ball_speed_mph   Decimal?         @db.Decimal(5, 1)
  launch_angle_deg Decimal?         @db.Decimal(4, 1)
  spin_rate_rpm    Int?
  carry_yards      Int?
  smash_factor     Decimal?         @db.Decimal(3, 2)
  source           String?          @db.VarChar(30)
  image_url        String?
  created_at       DateTime         @default(now())

  profile          fitting_profiles @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@map("fitting_swing_data")
}

model chip_conversations {
  id          String         @id @default(uuid())
  user_id     String
  listing_id  String?
  title       String?        @db.VarChar(100)
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  user        users          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  listing     listings?      @relation(fields: [listing_id], references: [id], onDelete: SetNull)
  messages    chip_messages[]

  @@index([user_id])
  @@index([listing_id])
  @@map("chip_conversations")
}

model chip_messages {
  id              String             @id @default(uuid())
  conversation_id String
  role            String             @db.VarChar(10)
  content         String
  tokens_used     Int?
  metadata        Json?              // Stores prompt_version and other debugging info
  created_at      DateTime           @default(now())

  conversation    chip_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([created_at])
  @@map("chip_messages")
}

model admin_audit_log {
  id          String   @id @default(uuid())
  action      String
  target_type String
  target_id   String?
  details     Json?
  admin_ip    String?
  created_at  DateTime @default(now())

  @@index([action])
  @@index([target_type, target_id])
  @@index([created_at])
}

model pro_store_applications {
  id                  String    @id @default(uuid())
  user_id             String
  business_name       String    @db.VarChar(100)
  business_email      String    @db.VarChar(255)
  business_phone      String    @db.VarChar(30)
  website             String    @db.VarChar(255)
  seller_type         String    @db.VarChar(30)
  description         String    @db.VarChar(500)
  estimated_listings  String    @db.VarChar(20)
  instagram_handle    String?   @db.VarChar(100)
  has_existing_store  Boolean   @default(false)
  existing_store_url  String?   @db.VarChar(255)
  status              String    @default("pending") @db.VarChar(20)
  review_notes        String?
  reviewed_by         String?   @db.VarChar(100)
  reviewed_at         DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user                users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("pro_store_applications")
}

model refresh_tokens {
  id           String    @id @default(uuid())
  user_id      String
  token_hash   String    @unique
  expires_at   DateTime
  revoked_at   DateTime?
  replaced_by  String?
  user_agent   String?
  created_at   DateTime  @default(now())
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}
